# PostgreSQL 管理账号只用于初始化；应用永远使用下面的只读账号。
POSTGRES_DB=dispatch_demo
POSTGRES_USER=demo_admin
POSTGRES_PASSWORD=change_me_admin_password
DEMO_READER_PASSWORD=change_me_reader_password
POSTGRES_PORT=5432

# hybrid：优先访问Windows Ollama，失败时自动回退规则解析。
PLANNER_MODE=hybrid
OLLAMA_BASE_URL=http://部署ollama模型的IP地址:11434
OLLAMA_MODEL=qwen35-local:latest

# 页面和接口端口。
API_PORT=8000
UI_PORT=8501
API_URL=http://127.0.0.1:8000



