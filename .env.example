# PostgreSQL 管理账号只用于初始化；应用永远使用下面的只读账号。
POSTGRES_DB=dispatch_demo
POSTGRES_USER=demo_admin
POSTGRES_PASSWORD=change_me_admin_password
DEMO_READER_PASSWORD=change_me_reader_password
POSTGRES_PORT=5432

# rule：完全离线、结果稳定；hybrid：优先调用 Ollama，失败时退回规则解析。
PLANNER_MODE=rule
OLLAMA_BASE_URL=http://192.168.1.100:11434
OLLAMA_MODEL=qwen3.5:9b

# 页面和接口端口。
API_PORT=8000
UI_PORT=8501
API_URL=http://127.0.0.1:8000



